# Polymarket Listener Configuration

# API base URL (default: https://data-api.polymarket.com)
# API_BASE_URL=https://data-api.polymarket.com

# Default user address to monitor (can be overridden with --user flag)
# USER_ADDRESS=0x...

# Polling interval in seconds (default: 30)
POLL_INTERVAL=1

# Maximum transactions per API request (default: 100, max: 500)
TRANSACTION_LIMIT=100

# Enable debug logging (default: false)
DEBUG=true

# Maximum number of retries on API error (default: 3)
# MAX_RETRIES=3

# Delay between retries in seconds (default: 5)
# RETRY_DELAY=5
